# คัดลอกเป็น .env แล้วกรอกค่าจริง (อย่า commit ไฟล์ .env)

# —— เซิร์ฟเวอร์ ——
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=เปลี่ยนเป็นสตริงสุ่มยาวๆ
# ถ้าอยู่หลัง HTTPS reverse proxy (เช่น Render):
# TRUST_PROXY=1
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
APP_BASE_URL=http://localhost:3000

# —— SQL Server (เชื่อมกับ database ที่มีอยู่แล้ว) ——
# ต้องมีตาราง dbo.users_main และ dbo.courses_main
DB_USER=uinet
DB_PASSWORD=
DB_SERVER=tvsdb2.thanvasupos.com
DB_PORT=28914
DB_NAME=BD_PTS
DB_SCHEMA=dbo
# false = ไม่สร้าง/แก้ตารางอัตโนมัติ (แนะนำเมื่อมี DB อยู่แล้ว)
DB_AUTO_SCHEMA=false
# DB_ENCRYPT=true
# DB_TRUST_CERT=true

# ทดสอบการเชื่อมต่อ: npm run db:check

# —— Email OTP (Google Workspace / Gmail App Password) ——
MAIL_MODE=smtp
MAIL_FROM_NAME=PTS Learning
MAIL_FROM_EMAIL=businessdev@thanvasu.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=businessdev@thanvasu.com
SMTP_PASS=

# หรือใช้ Brevo แทน
# BREVO_API_KEY=xkeysib-xxxxxxxx

# —— Google OAuth (เข้าสู่ระบบด้วย Gmail + Google Calendar) ——
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ต้องตรงกับ Authorized redirect URIs ใน Google Cloud Console
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
# หรือใส่ใน backend/google.local.js (ดู google.local.example.js)

# —— Google Drive (เก็บรูปอัปโหลด: โปรไฟล์ / สลิป) ——
# ดูคู่มือ GOOGLE_DRIVE.md
# GOOGLE_DRIVE_FOLDER_ID=
# แนะนำสำหรับ Gmail ส่วนตัว: รัน node backend/setup-google-drive-oauth.js
# (ใช้ GOOGLE_CLIENT_ID/SECRET เดิม แล้วได้ไฟล์ backend/google.drive.token.json)
# GOOGLE_SERVICE_ACCOUNT_FILE=backend/google-service-account.json

# —— LINE Official Account (Messaging + LIFF mini app) ——
# ลิงก์ Add friend จาก LINE Official Account Manager
# LINE_OA_ADD_FRIEND_URL=https://line.me/R/ti/p/@your-oa-id
# LINE_OA_NAME=PTS Learning
# Messaging API (Webhook: https://YOUR_DOMAIN/api/line/webhook)
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
# LIFF app ที่ชี้ไป https://YOUR_DOMAIN/LineApp.html
# LINE_LIFF_ID=
# โดเมนสาธารณะ (ใช้สร้างลิงก์ใน Flex Message)
# APP_BASE_URL=https://YOUR_DOMAIN

# —— PromptPay (ถ้ามี) ——
# PROMPTPAY_ID=

# —— Docker Hub image name (ใช้กับ docker compose) ——
# DOCKER_IMAGE=YOUR_DOCKERHUB_USER/pts-learning:latest
# HOST_PORT=3000
